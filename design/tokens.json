{
  "$description": "qcontroller design tokens. W3C Design Tokens format; consumable by Style Dictionary.",
  "color": {
    "$type": "color",
    "blue": {
      "50": {
        "$value": "#e7f5ff"
      },
      "100": {
        "$value": "#d0ebff"
      },
      "200": {
        "$value": "#a5d8ff"
      },
      "300": {
        "$value": "#74c0fc"
      },
      "400": {
        "$value": "#4dabf7"
      },
      "500": {
        "$value": "#339af0"
      },
      "600": {
        "$value": "#228be6",
        "$description": "Primary brand blue"
      },
      "700": {
        "$value": "#1c7ed6"
      },
      "800": {
        "$value": "#1971c2"
      },
      "900": {
        "$value": "#1864ab"
      }
    },
    "cyan": {
      "$description": "Secondary accent (node/image icons, image badges)",
      "50": {
        "$value": "#e3fafc"
      },
      "100": {
        "$value": "#c5f6fa"
      },
      "200": {
        "$value": "#99e9f2"
      },
      "300": {
        "$value": "#66d9e8"
      },
      "400": {
        "$value": "#3bc9db"
      },
      "500": {
        "$value": "#22b8cf"
      },
      "600": {
        "$value": "#15aabf"
      },
      "700": {
        "$value": "#1098ad"
      },
      "800": {
        "$value": "#0c8599"
      },
      "900": {
        "$value": "#0b7285"
      }
    },
    "gray": {
      "0": {
        "$value": "#ffffff"
      },
      "50": {
        "$value": "#f8f9fa"
      },
      "100": {
        "$value": "#f1f3f5"
      },
      "200": {
        "$value": "#e9ecef"
      },
      "300": {
        "$value": "#dee2e6"
      },
      "400": {
        "$value": "#ced4da"
      },
      "500": {
        "$value": "#adb5bd"
      },
      "600": {
        "$value": "#868e96"
      },
      "700": {
        "$value": "#495057"
      },
      "800": {
        "$value": "#343a40"
      },
      "900": {
        "$value": "#212529"
      }
    },
    "green": {
      "50": { "$value": "#ebfbee" },
      "100": { "$value": "#d3f9d8" },
      "200": { "$value": "#b2f2bb" },
      "300": { "$value": "#8ce99a" },
      "400": { "$value": "#69db7c" },
      "500": { "$value": "#51cf66" },
      "600": { "$value": "#40c057" },
      "700": { "$value": "#37b24d" },
      "800": { "$value": "#2f9e44" },
      "900": { "$value": "#2b8a3e" }
    },
    "orange": {
      "50": { "$value": "#fff4e6" },
      "100": { "$value": "#ffe8cc" },
      "200": { "$value": "#ffd8a8" },
      "300": { "$value": "#ffc078" },
      "400": { "$value": "#ffa94d" },
      "500": { "$value": "#ff922b" },
      "600": { "$value": "#fd7e14" },
      "700": { "$value": "#f76707" },
      "800": { "$value": "#e8590c" },
      "900": { "$value": "#d9480f" }
    },
    "red": {
      "50": { "$value": "#fff5f5" },
      "100": { "$value": "#ffe3e3" },
      "200": { "$value": "#ffc9c9" },
      "300": { "$value": "#ffa8a8" },
      "400": { "$value": "#ff8787" },
      "500": { "$value": "#ff6b6b" },
      "600": { "$value": "#fa5252" },
      "700": { "$value": "#f03e3e" },
      "800": { "$value": "#e03131" },
      "900": { "$value": "#c92a2a" }
    },
    "semantic": {
      "surface": {
        "page": {
          "$value": "{color.gray.50}"
        },
        "card": {
          "$value": "{color.gray.0}"
        },
        "header": {
          "$value": "{color.blue.800}",
          "$description": "app header bar"
        }
      },
      "border": {
        "default": {
          "$value": "{color.gray.200}"
        },
        "strong": {
          "$value": "{color.gray.300}"
        }
      },
      "text": {
        "primary": {
          "$value": "{color.gray.900}"
        },
        "secondary": {
          "$value": "{color.gray.700}"
        },
        "muted": {
          "$value": "{color.gray.600}"
        },
        "onHeader": {
          "$value": "{color.gray.0}",
          "$description": "text/icons on the header bar"
        }
      },
      "accent": {
        "default": {
          "$value": "{color.blue.600}"
        },
        "hover": {
          "$value": "{color.blue.800}"
        },
        "onAccent": {
          "$value": "{color.gray.0}"
        }
      },
      "vm": {
        "running": {
          "indicator": {
            "$value": "{color.green.800}"
          },
          "text": {
            "$value": "{color.green.900}"
          },
          "bg": {
            "$value": "{color.green.50}"
          }
        },
        "stopped": {
          "indicator": {
            "$value": "{color.gray.500}"
          },
          "text": {
            "$value": "{color.gray.700}"
          },
          "bg": {
            "$value": "{color.gray.100}"
          }
        },
        "pending": {
          "indicator": {
            "$value": "#f08c00"
          },
          "text": {
            "$value": "{color.orange.800}"
          },
          "bg": {
            "$value": "{color.orange.50}"
          }
        },
        "error": {
          "indicator": {
            "$value": "{color.red.800}"
          },
          "text": {
            "$value": "{color.red.900}"
          },
          "bg": {
            "$value": "{color.red.50}"
          }
        }
      },
      "danger": {
        "text": {
          "$value": "{color.red.800}"
        },
        "border": {
          "$value": "{color.red.200}"
        },
        "solid": {
          "$value": "{color.red.800}",
          "$description": "escalated destructive actions (force stop)"
        },
        "solidHover": {
          "$value": "{color.red.900}"
        },
        "onSolid": {
          "$value": "{color.gray.0}"
        }
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["IBM Plex Sans", "system-ui", "sans-serif"],
        "$description": "Headings & UI"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["IBM Plex Mono", "ui-monospace", "monospace"],
        "$description": "Specs, IDs, logs, timestamps"
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "11px",
        "$description": "micro labels, badge text"
      },
      "sm": {
        "$value": "12px",
        "$description": "secondary UI, mono specs"
      },
      "md": {
        "$value": "14px",
        "$description": "body / default UI"
      },
      "lg": {
        "$value": "16px"
      },
      "xl": {
        "$value": "18px",
        "$description": "section headings"
      },
      "2xl": {
        "$value": "22px",
        "$description": "page titles"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "lineHeight": {
      "$type": "number",
      "tight": {
        "$value": 1.25
      },
      "normal": {
        "$value": 1.5
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "8px grid with a 4px half-step",
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "24px"
    },
    "6": {
      "$value": "32px"
    },
    "7": {
      "$value": "48px"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "6px",
      "$description": "buttons, inputs, badges (rect)"
    },
    "md": {
      "$value": "8px",
      "$description": "cards, panels"
    },
    "pill": {
      "$value": "999px",
      "$description": "status badges"
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "default": {
        "$value": "1px"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": {
        "color": "#0000000a",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "raised": {
      "$value": {
        "color": "#0000000f",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "3px",
        "spread": "0px"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms",
        "$description": "hover, focus"
      },
      "base": {
        "$value": "200ms",
        "$description": "expand/collapse, badge state change"
      },
      "slow": {
        "$value": "320ms",
        "$description": "drawer, page-level"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [0.4, 0, 0.2, 1]
      },
      "decelerate": {
        "$value": [0, 0, 0.2, 1]
      }
    }
  }
}
